<Page x:Class="Lineage.Pages.EditStoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="800"
      Title="Добавление истории"
      Background="#F5F0E6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="10"
                          Opacity="0.1"
                          ShadowDepth="2"
                          Color="#5C4E3D"/>

        <!-- Стиль для кнопки "ОТМЕНА" -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0D5C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки "СОХРАНИТЬ" -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B7C8A8"/>
                                <Setter Property="Foreground" Value="#E8F0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок добавления медиафайлов -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки удаления медиафайла -->
        <Style x:Key="RemoveMediaButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E57373"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FCE4E4"/>
                                <Setter Property="Foreground" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Стиль для ListView -->
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Декоративный элемент -->
        <Border Width="400" Height="400"
                Background="#8B7E6B" Opacity="0.05"
                CornerRadius="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        <!-- Карточка редактирования -->
        <Border Width="700"
                Background="#FDF8F0"
                CornerRadius="20"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#B7A48B"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Opacity="0.15"
                                  ShadowDepth="5"
                                  Color="#5C4E3D"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0"
                           x:Name="txtPageTitle"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#5C4E3D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"
                           Text="ДОБАВЛЕНИЕ ИСТОРИИ"/>

                <!-- Информация о персоне -->
                <TextBlock Grid.Row="1"
                           x:Name="txtPersonInfo"
                           Foreground="#8B7E6B"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Margin="0,0,0,10"/>

                <!-- Поле Заголовок -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="Заголовок *" Foreground="#6B5E4A" Margin="0,0,0,2" FontSize="13"/>
                    <TextBox x:Name="txtTitle"
                             Height="30"
                             TextChanged="ValidateFields"
                             KeyDown="TextBox_KeyDown"
                             MaxLength="200"/>
                </StackPanel>

                <!-- Поле Дата события -->
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock Text="Дата события" Foreground="#6B5E4A" Margin="0,0,0,2" FontSize="13"/>
                    <DatePicker x:Name="dpEventDate" Height="30" KeyDown="DatePicker_KeyDown"/>
                    <TextBlock Text="или текстовое описание даты (например, 'лето 1985')"
                               Foreground="#8B7E6B"
                               FontSize="10"
                               Margin="0,2,0,0"/>
                    <TextBox x:Name="txtEventDateText"
                             Height="30"
                             Margin="0,5,0,0"
                             KeyDown="TextBox_KeyDown"
                             MaxLength="100"/>
                </StackPanel>

                <!-- Поле Содержание -->
                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="Текст истории *" Foreground="#6B5E4A" Margin="0,0,0,2" FontSize="13"/>
                    <TextBox x:Name="txtContent"
                             Height="120"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             TextChanged="ValidateFields"
                             KeyDown="TextBox_KeyDown"
                             MaxLength="5000"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Медиафайлы -->
                <GroupBox Grid.Row="5"
                          Header="Медиафайлы к истории">
                    <StackPanel>
                        <!-- Список прикрепленных файлов -->
                        <ListView x:Name="lvAttachedMedia"
                                  Height="80"
                                  Margin="0,0,0,5"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D6C9B8"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="5"
                                            Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="14"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       Foreground="#5C4E3D"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Style="{StaticResource RemoveMediaButtonStyle}"
                                                    Tag="{Binding FileId}"
                                                    Click="RemoveMedia_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Кнопки добавления -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📷 Фото" Style="{StaticResource MediaButtonStyle}" Click="AddPhoto_Click"/>
                            <Button Content="🎥 Видео" Style="{StaticResource MediaButtonStyle}" Click="AddVideo_Click"/>
                            <Button Content="🎵 Аудио" Style="{StaticResource MediaButtonStyle}" Click="AddAudio_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Кнопки -->
                <Grid Grid.Row="6" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="* - обязательные поля"
                               Foreground="#B7A48B" FontSize="10" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="ОТМЕНА"
                            Style="{StaticResource CancelButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button Grid.Column="2" x:Name="btnSave"
                            Content="СОХРАНИТЬ"
                            Style="{StaticResource SaveButtonStyle}"
                            IsEnabled="False"
                            Click="SaveButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>