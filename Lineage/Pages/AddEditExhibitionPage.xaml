<Page x:Class="Lineage.Pages.AddEditExhibitionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="Выставка"
      Background="#F5F0E6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Стиль для кнопки "ОТМЕНА" -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0D5C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки "СОХРАНИТЬ" -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Border Width="500"
                Background="#FDF8F0"
                CornerRadius="20"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#B7A48B"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Opacity="0.15"
                                  ShadowDepth="5"
                                  Color="#5C4E3D"/>
            </Border.Effect>

            <StackPanel>
                <Image Source="/Images/icon-tree.png" Width="50" Height="50" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="txtTitle"
                           Text="ДОБАВЛЕНИЕ ВЫСТАВКИ"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#5C4E3D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Название выставки -->
                <TextBlock Text="Название выставки *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtExhibitionName"/>

                <!-- Дата проведения -->
                <TextBlock Text="Дата проведения *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <DatePicker x:Name="dpExhibitionDate"/>

                <!-- Место проведения -->
                <TextBlock Text="Место проведения" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtLocation"/>

                <!-- Результат -->
                <TextBlock Text="Результат" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtResult"/>

                <!-- Судья -->
                <TextBlock Text="Судья" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtJudgeName"/>

                <!-- Оценка -->
                <TextBlock Text="Оценка (баллы)" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtRating"/>

                <!-- Номер сертификата -->
                <TextBlock Text="Номер сертификата" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtCertificateNumber"/>

                <!-- Примечания -->
                <TextBlock Text="Примечания" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Кнопки -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="ОТМЕНА"
                            Style="{StaticResource CancelButtonStyle}"
                            Margin="0,0,10,0" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                    <Button Grid.Column="1" Content="СОХРАНИТЬ"
                            Style="{StaticResource SaveButtonStyle}"
                            Margin="10,0,0,0" HorizontalAlignment="Left"
                            Click="SaveButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>