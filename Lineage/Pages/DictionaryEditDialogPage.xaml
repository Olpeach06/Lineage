<Page x:Class="Lineage.Pages.DictionaryEditDialogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="450"
      Title="Редактирование"
      Background="#F5F0E6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="20"
                          Opacity="0.15"
                          ShadowDepth="5"
                          Color="#5C4E3D"/>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Grid.Column="1" Width="400"
                    Background="#FDF8F0"
                    CornerRadius="20"
                    Padding="25"
                    BorderBrush="#B7A48B"
                    BorderThickness="1"
                    Effect="{StaticResource ShadowEffect}">

                <StackPanel>
                    <Image Source="/Images/icon-tree.png" Width="40" Height="40"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtTitle"
                               Text="ДОБАВЛЕНИЕ"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#5C4E3D"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Название -->
                    <TextBlock Text="Название *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtName"/>

                    <!-- Вид (для пород и окрасов) -->
                    <StackPanel x:Name="panelSpecies" Visibility="Collapsed">
                        <TextBlock Text="Вид" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                        <ComboBox x:Name="cmbSpecies" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <CheckBox x:Name="chkAllSpecies" Content="Для всех видов (без привязки)" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Код (для племенных классов) -->
                    <StackPanel x:Name="panelCode" Visibility="Collapsed">
                        <TextBlock Text="Код *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtCode"/>
                    </StackPanel>

                    <!-- Описание -->
                    <TextBlock Text="Описание" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="ОТМЕНА"
                                Style="{StaticResource CancelButtonStyle}"
                                Margin="0,0,10,0" Click="CancelButton_Click"/>
                        <Button Grid.Column="1" Content="СОХРАНИТЬ"
                                Style="{StaticResource SaveButtonStyle}"
                                Margin="10,0,0,0" Click="SaveButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>