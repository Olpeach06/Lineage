<Page x:Class="Lineage.Pages.AddEditDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="650"
      Title="Редактирование"
      Background="#F5F0E6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="20"
                          Opacity="0.15"
                          ShadowDepth="5"
                          Color="#5C4E3D"/>

        <!-- Стиль для кнопки "ОТМЕНА" -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0D5C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки "СОХРАНИТЬ" -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
        </Style>

        <!-- Стиль для CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="550"
                        Background="#FDF8F0"
                        CornerRadius="20"
                        Padding="30"
                        Margin="20"
                        BorderBrush="#B7A48B"
                        BorderThickness="1"
                        Effect="{StaticResource ShadowEffect}">

                    <StackPanel>
                        <Image Source="/Images/icon-tree.png" Width="50" Height="50"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="txtTitle"
                                   Text="ДОБАВЛЕНИЕ"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="#5C4E3D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- ========== ВЯЗКА ========== -->
                        <StackPanel x:Name="panelBreeding" Visibility="Collapsed">
                            <TextBlock Text="Производитель (самец) *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbMale" DisplayMemberPath="Nickname" SelectedValuePath="Id"/>

                            <TextBlock Text="Матка (самка) *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbFemale" DisplayMemberPath="Nickname" SelectedValuePath="Id"/>

                            <TextBlock Text="Дата вязки *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpBreedingDate"/>

                            <TextBlock Text="Ожидаемая дата родов" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpExpectedBirth"/>

                            <TextBlock Text="Фактическая дата родов" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpActualBirth"/>

                            <TextBlock Text="Количество родившихся" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtOffspringCount"/>

                            <TextBlock Text="Количество выживших" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtAliveCount"/>

                            <CheckBox x:Name="chkIsSuccessful" Content="Вязка успешна"/>

                            <TextBlock Text="Примечания" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- ========== ВЫСТАВКА ========== -->
                        <StackPanel x:Name="panelExhibition" Visibility="Collapsed">
                            <TextBlock Text="Название выставки *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtExhibitionName"/>

                            <TextBlock Text="Дата проведения *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpExhibitionDate"/>

                            <TextBlock Text="Место проведения" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtLocation"/>

                            <TextBlock Text="Результат" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtResult"/>

                            <TextBlock Text="Судья" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtJudgeName"/>

                            <TextBlock Text="Оценка (баллы)" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtRating"/>

                            <TextBlock Text="Номер сертификата" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtCertificateNumber"/>

                            <TextBlock Text="Примечания" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtExhibitionNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- ========== ОЦЕНКА ========== -->
                        <StackPanel x:Name="panelAssessment" Visibility="Collapsed">
                            <TextBlock Text="Дата оценки *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpAssessmentDate"/>

                            <TextBlock Text="Племенной класс *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbClass" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <TextBlock Text="Общая оценка" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtOverallScore"/>

                            <TextBlock Text="Оценка экстерьера" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtExteriorScore"/>

                            <TextBlock Text="Оценка продуктивности" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtProductivityScore"/>

                            <TextBlock Text="Оценка потомства" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtOffspringScore"/>

                            <TextBlock Text="Члены комиссии" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtCommissionMembers"/>

                            <TextBlock Text="Номер аттестата" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtAssessmentCertificateNumber"/>

                            <TextBlock Text="Срок действия" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpValidUntil"/>

                            <TextBlock Text="Примечания" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtAssessmentNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- ========== ВЕТЕРИНАРНОЕ СОБЫТИЕ ========== -->
                        <StackPanel x:Name="panelHealthEvent" Visibility="Collapsed">
                            <TextBlock Text="Дата события *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpEventDate"/>

                            <TextBlock Text="Тип события *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbEventType" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <TextBlock Text="Препарат" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtMedicineName"/>

                            <TextBlock Text="Дозировка" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtDosage"/>

                            <TextBlock Text="Ветеринар" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtVetName"/>

                            <TextBlock Text="Следующая обработка" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <DatePicker x:Name="dpNextDueDate"/>

                            <TextBlock Text="Стоимость (руб)" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtCost"/>

                            <TextBlock Text="Примечания" Foreground="#6B5E4A" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtHealthNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Кнопки -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ОТМЕНА"
                                    Style="{StaticResource CancelButtonStyle}"
                                    Margin="0,0,10,0" HorizontalAlignment="Right"
                                    Click="CancelButton_Click"/>
                            <Button Grid.Column="1" Content="СОХРАНИТЬ"
                                    Style="{StaticResource SaveButtonStyle}"
                                    Margin="10,0,0,0" HorizontalAlignment="Left"
                                    Click="SaveButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>