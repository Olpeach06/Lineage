<Page x:Class="Lineage.Pages.StoryDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="История"
      Background="#F5F0E6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="10"
                          Opacity="0.1"
                          ShadowDepth="2"
                          Color="#5C4E3D"/>

        <!-- Стиль для кнопки "Назад" -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#5C4E3D"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#FDF8F0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource ShadowEffect}"/>
        </Style>

        <!-- Стиль для медиафайлов -->
        <Style x:Key="MediaBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#B7A48B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F5F0E6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#FDF8F0"
                BorderBrush="#D6C9B8"
                BorderThickness="0,0,0,1"
                Padding="15,10"
                Effect="{StaticResource ShadowEffect}">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Назад" Style="{StaticResource BackButtonStyle}" Click="BackButton_Click"/>
                <TextBlock x:Name="txtPageTitle"
                           Text="История"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#5C4E3D"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Карточка истории -->
                <Border Style="{StaticResource BlockStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Заголовок -->
                        <TextBlock x:Name="txtTitle"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#5C4E3D"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <!-- Информация о персоне -->
                        <TextBlock x:Name="txtPersonInfo"
                                   Foreground="#8FAA7A"
                                   FontSize="14"
                                   Margin="0,0,0,15"/>

                        <!-- Дата события -->
                        <Border Background="#F5F0E6"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,15">
                            <WrapPanel>
                                <TextBlock Text="📅 " Foreground="#8FAA7A"/>
                                <TextBlock x:Name="txtEventDate"
                                           Text="Дата события:"
                                           Foreground="#6B5E4A"/>
                            </WrapPanel>
                        </Border>

                        <!-- Содержание истории -->
                        <TextBlock Text="📖 Содержание"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#5C4E3D"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtContent"
                                       TextWrapping="Wrap"
                                       Foreground="#6B5E4A"
                                       LineHeight="25"/>
                        </ScrollViewer>

                        <!-- Медиафайлы к истории -->
                        <TextBlock Text="🖼️ Прикрепленные файлы"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#5C4E3D"
                                   Margin="0,20,0,10"/>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icMedia" Margin="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MediaBorderStyle}"
                                                MouseLeftButtonDown="Media_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="30"
                                                           Foreground="#8FAA7A"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,5"/>
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="#6B5E4A"
                                                           FontSize="10"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>