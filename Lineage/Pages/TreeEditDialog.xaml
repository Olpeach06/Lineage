<Window x:Class="Lineage.Pages.TreeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование проекта"
        Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Icon="/Images/icon.ico"
        Background="#F5F0E6"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для кнопки "ОТМЕНА" -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D6C9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5E4A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0E9DE"/>
                                <Setter Property="Foreground" Value="#8FAA7A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8FAA7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0D5C4"/>
                                <Setter Property="Foreground" Value="#5C4E3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки "СОХРАНИТЬ" -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8FAA7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A9A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6B8A58"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B7C8A8"/>
                                <Setter Property="Foreground" Value="#E8F0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="#FDF8F0" CornerRadius="10" Padding="20">
        <StackPanel>
            <Image Source="/Images/icon-tree.png" Width="60" Height="60" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock x:Name="txtTitle" Text="СОЗДАНИЕ ПРОЕКТА"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#5C4E3D"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Название *" Foreground="#6B5E4A" Margin="0,5,0,2"/>
            <TextBox x:Name="txtName"
                     Padding="8"
                     BorderBrush="#B7A48B"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     Margin="0,0,0,10"
                     TextChanged="ValidateFields"/>

            <TextBlock Text="Описание" Foreground="#6B5E4A" Margin="0,5,0,2"/>
            <TextBox x:Name="txtDescription"
                     Padding="8"
                     BorderBrush="#B7A48B"
                     BorderThickness="0,0,0,1"
                     Background="Transparent"
                     Margin="0,0,0,15"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="80"/>

            <CheckBox x:Name="chkIsPublic"
                      Content="Публичный проект (доступен для просмотра всем)"
                      Foreground="#6B5E4A"
                      Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="ОТМЕНА"
                        Width="100" Height="35"
                        Style="{StaticResource CancelButtonStyle}"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="1"
                        x:Name="btnSave"
                        Content="СОХРАНИТЬ"
                        Width="100" Height="35"
                        Style="{StaticResource SaveButtonStyle}"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>